   "source": [
    "# --- GENDER BINARY ENCODING ---\n",
    "# Convert to lowercase and strip spaces just in case\n",
    "data[\"Gender\"] = data[\"Gender\"].str.lower().str.strip()\n",
    "\n",
    "# Map to binary (you can customize)\n",
    "gender_map = {\n",
    "    \"male\": 1,\n",
    "    \"m\": 1,\n",
    "    \"female\": 0,\n",
    "    \"f\": 0\n",
    "}\n",
    "\n",
    "data[\"Gender_Binary\"] = data[\"Gender\"].map(gender_map)\n",
    "\n",
    "data['EnrollmentType'] = data['EnrollmentType'].map({'Standard': 0, '2021 Promotion': 1})\n",
    "data['EnrollmentType'] = data['EnrollmentType'].astype(bool).astype(int)\n",
    "\n",
    "# If there are unknown values, fill with NaN or a special code\n",
    "data[\"Gender_Binary\"] = data[\"Gender_Binary\"].fillna(-1)   # -1 = unknown\n",
    "\n",
    "# --- ONE-HOT ENCODE LOYALTY STATUS ---\n",
    "data = pd.get_dummies(data, columns=[\"LoyaltyStatus\"], prefix=\"Loyalty\", dtype=int)\n",
    "\n",
    "# --- ONE-HOT ENCODE Education ---\n",
    "data = pd.get_dummies(data, columns=[\"Education\"], prefix=\"Education\", dtype=int)\n",
    "\n",
    "# --- ONE-HOT ENCODE MARITAL STATUS ---\n",
    "data = pd.get_dummies(data, columns=[\"Marital Status\"], prefix=\"Marital\", dtype=int)\n",
    "\n",
    "# --- ONE-HOT ENCODE LOCATION CLUSTERS ---\n",
    "data = pd.get_dummies(data, columns=[\"Location_cluster\"], prefix=\"Location_\", dtype=int)\n"
   ]
  },
